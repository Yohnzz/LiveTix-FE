# Template Supabase Configuration for LiveTix
# Salin file ini menjadi .env dan masukkan URL serta anon/publishable key Supabase kamu
SUPABASE_URL=asdasdasdasdasd
SUPABASE_ANON_KEY=asdasdasdasdasd

# Opsional: alamat kembali setelah login Google OAuth.
# Web default memakai origin aplikasi. Android/iOS memakai deep link di bawah.
# Daftarkan nilai ini di Supabase Dashboard -> Authentication -> Redirect URLs.
# AUTH_REDIRECT_URL=io.livetix.app://login-callback

AI_BACKEND_URL=asdjkasdkansdkasd

# Gemini API Key untuk AI Customer Service (User, Produser, Admin)
GEMINI_API_KEY=sdfsdfsdf

# Peta & pencarian lokasi memakai OpenStreetMap/Nominatim gratis bawaan.
